<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sr7d3v.hibermate.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/HibermateHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.sr7d3v.hibermate.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.sr7d3v.hibermate</string>
	</array>
	<!-- Started on boot so reconciliation runs even if the app never launches
	     again (e.g. a reboot mid-hold). It idles otherwise. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
